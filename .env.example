# Backend
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
FRONTEND_URL=http://localhost:5173
PORT=3001
NODE_ENV=development
LOG_LEVEL=info
CHAT_RATE_LIMIT_MAX=15
CHAT_RATE_LIMIT_WINDOW_MS=60000
GEMINI_TIMEOUT_MS=25000
SESSION_TTL_MS=21600000
DATA_RETENTION_DAYS=30

# PostgreSQL + pgvector. Required in production so sessions, analytics, and embeddings survive deploys.
DATABASE_URL=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=768

# Frontend (used by Vite in local development; leave empty in production so the UI calls /api on the same origin)
VITE_API_URL=

# Private analytics dashboard (GET /api/analytics and /analytics)
ANALYTICS_KEY=dev-analytics
